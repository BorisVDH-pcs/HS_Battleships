# Supabase — safe to expose to the browser (RLS protects the data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# imgbb — safe to expose to the browser too: it only authorizes uploads to a
# public image host, nothing it gates is otherwise private. Used to mirror
# evidence/pet-jar screenshots so Discord can embed them (see 0040). Deploys
# read this from the repo secret IMGBB_API (.github/workflows/deploy.yml); if
# unset, submissions still work, they just post to Discord as text only.
VITE_IMGBB_API_KEY=

# Server-side only. NEVER prefix these with VITE_ — that would ship them to the client.
SUPABASE_SERVICE_ROLE_KEY=
DISCORD_WEBHOOK_TEAM_A=
DISCORD_WEBHOOK_TEAM_B=
DISCORD_WEBHOOK_GENERAL=
